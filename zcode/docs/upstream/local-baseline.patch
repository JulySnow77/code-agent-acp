+    def test_timeout_logs_req_id_and_cancels(self):
+        bridge, turn = _bridge_with_turn()
+        old = MOD.QUESTION_TIMEOUT_S
+        MOD.QUESTION_TIMEOUT_S = 0.15
+        try:
+            err = _stderr_of(
+                lambda: bridge._handle_user_input_request(self._event(), "acp-s1", turn))
+        finally:
+            MOD.QUESTION_TIMEOUT_S = old
