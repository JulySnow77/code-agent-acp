+
+func executionFixture(t *testing.T) (*Store, domain.Run, domain.Attempt) {
+	t.Helper()
+	s := testStore(t)
+	ctx := context.Background()
+	r := testRun(t, s, "execution-run")
+	r, a, err := s.StartAttempt(ctx, r.ID, r.Version, "execution-attempt", "execution-epoch")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = s.RegisterProject(ctx, domain.Project{ID: "p", Root: "/project", Kind: "directory"}); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.ReserveSnapshot(ctx, "snapshot", "p", ""); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.FinishSnapshot(ctx, "snapshot", "", []byte(`{}`), true); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.ReserveWorkspace(ctx, domain.Workspace{ID: "workspace", SnapshotID: "snapshot", AttemptID: a.ID, ConnectionID: a.ConnectionID}); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.FinishWorkspace(ctx, "workspace", true); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.BeginExecution(ctx, a.ID, "workspace", "/managed/tree"); err != nil {
