+	for _, stage := range []string{"process_starting", "process_started", "session_ready"} {
+		if err = s.ExecutionStage(ctx, domain.Execution{AttemptID: a.ID, Stage: stage, PID: 123, SessionID: "session", Model: "p/model", Mode: "build"}); err != nil {
