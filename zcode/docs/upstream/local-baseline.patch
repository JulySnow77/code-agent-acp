+class TestAskUserQuestionTimeoutE2E(unittest.TestCase):
+    """A permission request the ACP client never answers must time out, not hang.
+
+    Mirrors root-cause B-1: if omnigent never replies to the
+    ``session/request_permission`` (e.g. the web elicitation was abandoned),
+    the bridge's per-question polling loop hits ``QUESTION_TIMEOUT_S`` and
+    must reply ``{"action": "cancel"}`` to zcode so the turn ends — never
+    block forever. The unit test already pins the cancel; this e2e pins the
+    full subprocess path (real bridge + fake zcode + no ACP reply) and that
+    the timeout is observable on stderr (the new diagnostic log).
+    """
+
+    def setUp(self) -> None:
+        self._state_file = tempfile.NamedTemporaryFile(
+            mode="w", suffix=".json", delete=False
+        )
+        self._state_file.close()
+
+    def tearDown(self) -> None:
+        try:
+            os.unlink(self._state_file.name)
+        except OSError:
+            pass
+
+    def test_timeout_replies_cancel_to_zcode(self) -> None:
+        proc = _spawn_bridge({
+            "FAKE_ZCODE_STATE_FILE": self._state_file.name,
+            # 1s question timeout — short enough to keep the test fast,
+            # long enough that the turn has time to surface the request.
+            "ZCODE_ACP_QUESTION_TIMEOUT": "1",
+        })
+        client = ACPClient(proc)
+        try:
+            client.request(1, "initialize", {"protocolVersion": 1})
+            client.wait_response(1)
+            client.request(2, "session/new", {"cwd": "/tmp"})
+            new_session = client.wait_response(2)
+            acp_sid = new_session["result"]["sessionId"]
+
+            client.request(3, "session/prompt", {
+                "sessionId": acp_sid,
+                "prompt": [{"type": "text", "text": "ASK_USER_QUESTION"}],
+            })
+
+            # See the permission request but DELIBERATELY do not reply.
+            # Then wait for the prompt to complete via the timeout path.
+            perm_seen: list[dict[str, Any]] = []
+            prompt_resp: dict[str, Any] | None = None
+            # 1s question timeout + bridge polling overhead; allow 15s.
+            deadline = time.time() + 15.0
+            while time.time() < deadline and prompt_resp is None:
+                try:
+                    msg = client.inbox.get(timeout=0.5)
+                except queue.Empty:
+                    continue
+                if msg.get("method") == "session/request_permission":
+                    perm_seen.append(msg)
+                    continue
+                if msg.get("id") == 3 and msg.get("method") is None:
+                    prompt_resp = msg
+
+            self.assertGreaterEqual(len(perm_seen), 1,
+                                    "bridge never asked the question")
+            self.assertIsNotNone(prompt_resp,
+                                 "bridge hung on the unanswered question instead of timing out")
+
+            # The cancel the bridge sent to zcode is recorded in the state file.
+            with open(self._state_file.name, encoding="utf-8") as f:
+                zcode_reply = json.load(f)
+            self.assertEqual(zcode_reply["result"]["action"], "cancel")
+        finally:
+            client.close()
+
