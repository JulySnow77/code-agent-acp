new file mode 100644
--- /dev/null
+++ b/test/fixture/zcode/main.go
@@ -0,0 +1,107 @@
+// This deterministic ZCode fixture performs file effects only after session/send.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+)
+
+func main() {
+	for _, a := range os.Args[1:] {
+		if a == "--version" {
+			fmt.Println("0.16.9")
+			return
+		}
+	}
+	scenario := os.Getenv("O04_SCENARIO")
+	logPath := os.Getenv("O04_LOG")
+	log, _ := os.OpenFile(logPath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if log != nil {
+		defer log.Close()
+	}
+	send := func(v any) { raw, _ := json.Marshal(v); fmt.Println(string(raw)) }
+	settings := func(model string) map[string]any {
+		return map[string]any{"mode": map[string]any{"current": "build"}, "model": map[string]any{"current": map[string]any{"providerId": "p", "modelId": model}, "available": []any{map[string]any{"ref": map[string]any{"providerId": "p", "modelId": "model"}, "label": "Model"}, map[string]any{"ref": map[string]any{"providerId": "p", "modelId": "other"}, "label": "Other"}}}}
+	}
+	emit := func(kind string, payload map[string]any) {
+		send(map[string]any{"method": "session/event", "params": map[string]any{"sessionId": "fixture-session", "type": kind, "payload": payload}})
+	}
+	complete := func() {
+		if scenario != "no_file" {
+			if err := os.WriteFile("result.txt", []byte("done"), 0600); err != nil {
+				panic(err)
+			}
+		}
+		emit("model.streaming", map[string]any{"kind": "text_delta", "delta": "Task complete"})
+		emit("turn.completed", map[string]any{"resultType": "success"})
+	}
+	in := bufio.NewScanner(os.Stdin)
+	in.Buffer(make([]byte, 4096), 2<<20)
+	for in.Scan() {
+		var msg struct {
+			Result map[string]any  `json:"result"`
+			ID     json.RawMessage `json:"id"`
+			Method string          `json:"method"`
+			Params map[string]any  `json:"params"`
+		}
+		if json.Unmarshal(in.Bytes(), &msg) != nil {
+			continue
+		}
+		if log != nil {
+			log.Write(append(append([]byte(nil), in.Bytes()...), '\n'))
+			log.Sync()
+		}
+		if msg.Method == "" {
+			if strings.Contains(string(msg.ID), "permission") || strings.Contains(string(msg.ID), "question") {
+				if msg.Result["decision"] == "allow" || msg.Result["action"] == "accept" {
+					complete()
+				} else {
+					emit("turn.completed", map[string]any{"resultType": "cancelled"})
+				}
+			}
+			continue
+		}
+		reply := func(result any) { send(map[string]any{"id": msg.ID, "result": result}) }
+		switch msg.Method {
+		case "workspace/readState":
+			send(map[string]any{"id": "invalid-message", "error": map[string]any{"code": -32600, "message": "invalid_union"}})
+		case "session/create":
+			reply(map[string]any{"session": map[string]any{"sessionId": "fixture-session"}, "settings": settings("model")})
+		case "session/setMode", "session/subscribe":
+			reply(map[string]any{})
+		case "session/setModel":
+			if scenario == "model_error" {
+				send(map[string]any{"id": msg.ID, "error": map[string]any{"code": -32000, "message": "model unavailable"}})
+			} else {
+				model := "model"
+				if scenario == "model_mismatch" {
+					model = "other"
+				}
+				reply(map[string]any{"settings": settings(model)})
+			}
+		case "session/messages":
+			reply(map[string]any{"messages": []any{}})
+		case "session/send":
+			reply(map[string]any{"accepted": true})
+			switch scenario {
+			case "wait":
+			case "backend_exit":
+				os.Exit(17)
+			case "permission":
+				send(map[string]any{"id": "permission-1", "method": "interaction/requestPermission", "params": map[string]any{"sessionId": "fixture-session", "requestId": "permission", "toolCallId": "tool", "toolName": "Write", "options": []any{map[string]any{"optionId": "allow_once", "kind": "allow_once", "name": "Allow once", "response": map[string]any{"decision": "allow"}}}}})
+			case "form":
+				send(map[string]any{"id": "question-1", "method": "interaction/requestUserInput", "params": map[string]any{"sessionId": "fixture-session", "questions": []any{map[string]any{"question": "Approve plan?", "options": []any{map[string]any{"label": "Approve", "value": "approve"}}}}}})
+			default:
+				complete()
+			}
+		case "session/stop":
+			reply(map[string]any{})
+			emit("turn.completed", map[string]any{"resultType": "cancelled"})
+		default:
+			reply(map[string]any{})
+		}
+	}
+}
