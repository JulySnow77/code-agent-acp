+def _init_and_new_session(client: ACPClient) -> str:
+    """initialize + session/new, returning the ACP sessionId."""
+    client.request(1, "initialize", {"protocolVersion": 1, "clientCapabilities": {}})
+    init = client.wait_response(1)
+    assert init["result"]["protocolVersion"] == 1
+    client.request(2, "session/new", {"cwd": "/tmp"})
+    new_session = client.wait_response(2)
+    acp_sid = new_session["result"]["sessionId"]
+    assert acp_sid
+    return acp_sid
+
+
+def _drive_prompt(
+    client: ACPClient,
+    acp_sid: str,
+    prompt_text: str,
+    answer_perm: Any,
+    timeout: float = 30.0,
+    prompt_id: int = 3,
+) -> tuple[list[dict[str, Any]], dict[str, Any] | None]:
+    """Send session/prompt and drain until the prompt response lands.
+
+    ``answer_perm(msg, perms)`` runs for every mid-turn
+    ``session/request_permission`` (it decides what — and whether — to
+    reply). Returns ``(perm_requests, prompt_response_or_None)``.
+    """
+    client.request(prompt_id, "session/prompt", {
+        "sessionId": acp_sid,
+        "prompt": [{"type": "text", "text": prompt_text}],
+    })
+    perms: list[dict[str, Any]] = []
+    prompt_resp: dict[str, Any] | None = None
+    deadline = time.time() + timeout
+    while time.time() < deadline and prompt_resp is None:
+        try:
+            msg = client.inbox.get(timeout=0.5)
+        except queue.Empty:
+            continue
+        if msg.get("method") == "session/request_permission":
+            perms.append(msg)
+            answer_perm(msg, perms)
+            continue
+        if msg.get("id") == prompt_id and msg.get("method") is None:
+            prompt_resp = msg
+    return perms, prompt_resp
+
