+// Package agent defines the protocol-independent boundary consumed by execution.
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+)
+
+var ErrDisconnected = errors.New("agent connection lost")
+var ErrInvalidAnswer = errors.New("invalid interaction answer")
+
+type Event struct {
+	Kind    string
+	Payload json.RawMessage
+}
+type Interaction struct {
+	Kind    string
+	Request json.RawMessage
+}
+type Answer struct {
+	InteractionID string         `json:"-"`
+	Action        string         `json:"action"`
+	OptionID      string         `json:"optionId,omitempty"`
+	Content       map[string]any `json:"content,omitempty"`
+}
+type Hooks struct {
+	Event       func(context.Context, Event) error
+	Interaction func(context.Context, Interaction) (Answer, error)
+	Reply       func(context.Context, string) error
+	Fail        context.CancelCauseFunc
+}
+type Session struct{ ID, Model, Mode string }
+type Result struct {
+	StopReason, Text string
+	TextTruncated    bool
+}
+type Client interface {
+	Prepare(context.Context, string, string, string) (Session, error)
+	Prompt(context.Context, string) (Result, error)
+	Cancel(context.Context) error
+	Close(context.Context) error
+}
+type Factory func(context.Context, io.Writer, io.Reader, Hooks) Client
diff --git a/internal/agent/zcode/client.go b/internal/agent/zcode/client.go
new file mode 100644
--- /dev/null
+++ b/internal/agent/zcode/client.go
@@ -0,0 +1,373 @@
+// Package zcode is the only production package that imports ACP SDK types.
+package zcode
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"reflect"
+	"sync"
+
+	acp "github.com/coder/acp-go-sdk"
+	"zcode-orchestrator-go/internal/agent"
+)
+
+type client struct {
+	conn                *acp.ClientSideConnection
+	ctx                 context.Context
+	cancel              context.CancelFunc
+	hooks               agent.Hooks
+	mu                  sync.Mutex
+	closed              bool
+	wg                  sync.WaitGroup
+	session, mode, text string
+	truncated           bool
+	err                 error
+}
+
+func New(ctx context.Context, in io.Writer, out io.Reader, hooks agent.Hooks) agent.Client {
+	life, cancel := context.WithCancel(ctx)
+	c := &client{ctx: life, cancel: cancel, hooks: hooks}
+	c.conn = acp.NewClientSideConnection(c, in, out)
+	c.conn.SetLogger(slog.New(slog.NewTextHandler(io.Discard, nil)))
+	return c
+}
+func (c *client) fail(err error) error {
+	if err == nil {
+		return nil
+	}
+	c.mu.Lock()
+	if c.err == nil {
+		c.err = err
+	}
+	c.mu.Unlock()
+	if c.hooks.Fail != nil {
+		c.hooks.Fail(err)
+	}
+	return err
+}
+func (c *client) enter(ctx context.Context) (context.Context, func(), error) {
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return nil, nil, context.Canceled
+	}
+	c.wg.Add(1)
+	c.mu.Unlock()
+	merged, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(c.ctx, cancel)
+	return merged, func() { stop(); cancel(); c.wg.Done() }, nil
+}
+func (c *client) Prepare(ctx context.Context, cwd, model, mode string) (agent.Session, error) {
+	var result agent.Session
+	init, err := c.conn.Initialize(ctx, acp.InitializeRequest{ProtocolVersion: 1, ClientCapabilities: acp.ClientCapabilities{Meta: map[string]any{"_zcode": map[string]any{"cancelRequest": true}}, Elicitation: &acp.ElicitationCapabilities{Form: &acp.ElicitationFormCapabilities{}}}})
+	if err != nil {
+		return result, err
+	}
+	meta, _ := init.Meta["_zcode"].(map[string]any)
+	if init.ProtocolVersion != 1 || meta["cancelRequest"] != true {
+		return result, errors.New("bridge lacks required cancellation capability")
+	}
+	session, err := c.conn.NewSession(ctx, acp.NewSessionRequest{Cwd: cwd, McpServers: []acp.McpServer{}})
+	if err != nil {
+		return result, err
+	}
+	if session.SessionId == "" || session.Modes == nil || session.Modes.CurrentModeId != "build" {
+		return result, errors.New("new session did not confirm build mode")
+	}
+	c.mu.Lock()
+	c.session = string(session.SessionId)
+	c.mode = string(session.Modes.CurrentModeId)
+	c.mu.Unlock()
+	if _, err = c.conn.SetSessionMode(ctx, acp.SetSessionModeRequest{SessionId: session.SessionId, ModeId: acp.SessionModeId(mode)}); err != nil {
+		return result, err
+	}
+	config, err := c.conn.SetSessionConfigOption(ctx, acp.SetSessionConfigOptionRequest{ValueId: &acp.SetSessionConfigOptionValueId{SessionId: session.SessionId, ConfigId: "model", Value: acp.SessionConfigValueId(model)}})
+	if err != nil {
+		return result, err
+	}
+	confirmed := false
+	for _, option := range config.ConfigOptions {
+		if option.Select != nil && option.Select.Id == "model" && string(option.Select.CurrentValue) == model {
+			confirmed = true
+		}
+	}
+	c.mu.Lock()
+	actualMode := c.mode
+	callbackErr := c.err
+	c.mu.Unlock()
+	if callbackErr != nil {
+		return result, callbackErr
+	}
+	if !confirmed || actualMode != mode {
+		return result, errors.New("model/mode readback mismatch")
+	}
+	return agent.Session{ID: string(session.SessionId), Model: model, Mode: actualMode}, nil
+}
+func (c *client) Prompt(ctx context.Context, prompt string) (agent.Result, error) {
+	c.mu.Lock()
+	sid := c.session
+	c.mu.Unlock()
+	if sid == "" {
+		return agent.Result{}, errors.New("session not prepared")
+	}
+	response, err := c.conn.Prompt(ctx, acp.PromptRequest{SessionId: acp.SessionId(sid), Prompt: []acp.ContentBlock{acp.TextBlock(prompt)}})
+	c.mu.Lock()
+	result := agent.Result{StopReason: string(response.StopReason), Text: c.text, TextTruncated: c.truncated}
+	callbackErr := c.err
+	c.mu.Unlock()
+	if callbackErr != nil {
+		return result, callbackErr
+	}
+	if err != nil {
+		select {
+		case <-c.conn.Done():
+			return result, fmt.Errorf("%w: %v", agent.ErrDisconnected, err)
+		default:
+		}
+		return result, err
+	}
+	return result, nil
+}
+func (c *client) Cancel(ctx context.Context) error {
+	c.mu.Lock()
+	sid := c.session
+	c.mu.Unlock()
+	if sid == "" {
+		return nil
+	}
+	return c.conn.Cancel(ctx, acp.CancelNotification{SessionId: acp.SessionId(sid)})
+}
+func (c *client) Close(ctx context.Context) error {
+	c.mu.Lock()
+	c.closed = true
+	c.mu.Unlock()
+	c.cancel()
+	done := make(chan struct{})
+	go func() { c.wg.Wait(); close(done) }()
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+func (c *client) SessionUpdate(ctx context.Context, p acp.SessionNotification) error {
+	ctx, leave, err := c.enter(ctx)
+	if err != nil {
+		return err
+	}
+	defer leave()
+	c.mu.Lock()
+	sid := c.session
+	if sid == "" || string(p.SessionId) != sid {
+		c.mu.Unlock()
+		return c.fail(errors.New("notification belongs to an unbound session"))
+	}
+	kind := "agent.other"
+	switch {
+	case p.Update.AgentMessageChunk != nil:
+		kind = "agent.message"
+		if p.Update.AgentMessageChunk.Content.Text != nil {
+			chunk := p.Update.AgentMessageChunk.Content.Text.Text
+			remaining := (64 << 10) - len(c.text)
+			if len(chunk) > remaining {
+				chunk = chunk[:remaining]
+				c.truncated = true
+			}
+			c.text += chunk
+		}
+	case p.Update.AgentThoughtChunk != nil:
+		kind = "agent.thought"
+	case p.Update.ToolCall != nil || p.Update.ToolCallUpdate != nil:
+		kind = "agent.tool"
+	case p.Update.UsageUpdate != nil:
+		kind = "agent.usage"
+	case p.Update.CurrentModeUpdate != nil:
+		kind = "agent.mode"
+		c.mode = string(p.Update.CurrentModeUpdate.CurrentModeId)
+	case p.Update.ConfigOptionUpdate != nil:
+		kind = "agent.config"
+	case p.Update.Plan != nil:
+		kind = "agent.plan"
+	}
+	c.mu.Unlock()
+	raw, err := json.Marshal(p.Update)
+	if err != nil {
+		return c.fail(err)
+	}
+	if c.hooks.Event == nil {
+		return c.fail(errors.New("event persistence callback missing"))
+	}
+	return c.fail(c.hooks.Event(ctx, agent.Event{Kind: kind, Payload: raw}))
+}
+func (c *client) ask(ctx context.Context, kind string, request any) (agent.Answer, error) {
+	raw, err := json.Marshal(request)
+	if err != nil {
+		return agent.Answer{}, err
+	}
+	if c.hooks.Interaction == nil {
+		<-ctx.Done()
+		return agent.Answer{}, ctx.Err()
+	}
+	answer, err := c.hooks.Interaction(ctx, agent.Interaction{Kind: kind, Request: raw})
+	if err != nil {
+		return answer, c.fail(err)
+	}
+	return answer, nil
+}
+func (c *client) RequestPermission(ctx context.Context, p acp.RequestPermissionRequest) (acp.RequestPermissionResponse, error) {
+	ctx, leave, err := c.enter(ctx)
+	if err != nil {
+		return acp.RequestPermissionResponse{}, err
+	}
+	defer leave()
+	c.mu.Lock()
+	sid := c.session
+	c.mu.Unlock()
+	if sid == "" || string(p.SessionId) != sid {
+		return acp.RequestPermissionResponse{}, c.fail(errors.New("permission session mismatch"))
+	}
+	a, err := c.ask(ctx, "permission", p)
+	if err != nil {
+		return acp.RequestPermissionResponse{}, err
+	}
+	if a.Action == "cancel" || a.Action == "decline" {
+		if err = c.reply(ctx, a); err != nil {
+			return acp.RequestPermissionResponse{}, err
+		}
+		return acp.RequestPermissionResponse{Outcome: acp.RequestPermissionOutcome{Cancelled: &acp.RequestPermissionOutcomeCancelled{}}}, nil
+	}
+	if a.Action == "accept" {
+		for _, option := range p.Options {
+			if string(option.OptionId) == a.OptionID {
+				if err = c.reply(ctx, a); err != nil {
+					return acp.RequestPermissionResponse{}, err
+				}
+				return acp.RequestPermissionResponse{Outcome: acp.RequestPermissionOutcome{Selected: &acp.RequestPermissionOutcomeSelected{OptionId: option.OptionId}}}, nil
+			}
+		}
+	}
+	return acp.RequestPermissionResponse{}, c.fail(agent.ErrInvalidAnswer)
+}
+func (c *client) UnstableCreateElicitation(ctx context.Context, p acp.UnstableCreateElicitationRequest) (acp.UnstableCreateElicitationResponse, error) {
+	ctx, leave, err := c.enter(ctx)
+	if err != nil {
+		return acp.UnstableCreateElicitationResponse{}, err
+	}
+	defer leave()
+	if p.Form == nil {
+		return acp.UnstableCreateElicitationResponse{}, c.fail(agent.ErrInvalidAnswer)
+	}
+	a, err := c.ask(ctx, "form", p)
+	if err != nil {
+		return acp.UnstableCreateElicitationResponse{}, err
+	}
+	switch a.Action {
+	case "cancel":
+		if err = c.reply(ctx, a); err != nil {
+			return acp.UnstableCreateElicitationResponse{}, err
+		}
+		return acp.UnstableCreateElicitationResponse{Cancel: &acp.UnstableCreateElicitationCancel{}}, nil
+	case "decline":
+		if err = c.reply(ctx, a); err != nil {
+			return acp.UnstableCreateElicitationResponse{}, err
+		}
+		return acp.UnstableCreateElicitationResponse{Decline: &acp.UnstableCreateElicitationDecline{}}, nil
+	case "accept":
+		raw, _ := json.Marshal(p.Form.RequestedSchema)
+		if err = validateForm(raw, a.Content); err != nil {
+			return acp.UnstableCreateElicitationResponse{}, c.fail(err)
+		}
+		if err = c.reply(ctx, a); err != nil {
+			return acp.UnstableCreateElicitationResponse{}, err
+		}
+		return acp.UnstableCreateElicitationResponse{Accept: &acp.UnstableCreateElicitationAccept{Content: a.Content}}, nil
+	}
+	return acp.UnstableCreateElicitationResponse{}, c.fail(agent.ErrInvalidAnswer)
+}
+
+// O04 accepts only the primitive boolean/string/enum forms already exercised by
+// the bridge contract. Rich form constraints require the O05 validator.
+func validateForm(raw []byte, content map[string]any) error {
+	var schema struct {
+		Properties map[string]map[string]any `json:"properties"`
+		Required   []string                  `json:"required"`
+	}
+	if json.Unmarshal(raw, &schema) != nil || schema.Properties == nil || content == nil {
+		return agent.ErrInvalidAnswer
+	}
+	for _, key := range schema.Required {
+		if _, ok := content[key]; !ok {
+			return agent.ErrInvalidAnswer
+		}
+	}
+	for key, value := range content {
+		prop, ok := schema.Properties[key]
+		if !ok {
+			return agent.ErrInvalidAnswer
+		}
+		for constraint := range prop {
+			switch constraint {
+			case "type", "title", "description", "enum", "default", "_meta":
+			default:
+				return agent.ErrInvalidAnswer
+			}
+		}
+		switch prop["type"] {
+		case "string":
+			if _, ok = value.(string); !ok {
+				return agent.ErrInvalidAnswer
+			}
+		case "boolean":
+			if _, ok = value.(bool); !ok {
+				return agent.ErrInvalidAnswer
+			}
+		default:
+			return agent.ErrInvalidAnswer
+		}
+		if options, ok := prop["enum"].([]any); ok {
+			found := false
+			for _, option := range options {
+				if reflect.DeepEqual(option, value) {
+					found = true
+				}
+			}
+			if !found {
+				return agent.ErrInvalidAnswer
+			}
+		}
+	}
+	return nil
+}
+func (*client) ReadTextFile(context.Context, acp.ReadTextFileRequest) (acp.ReadTextFileResponse, error) {
+	return acp.ReadTextFileResponse{}, acp.NewMethodNotFound("ReadTextFile")
+}
+func (*client) WriteTextFile(context.Context, acp.WriteTextFileRequest) (acp.WriteTextFileResponse, error) {
+	return acp.WriteTextFileResponse{}, acp.NewMethodNotFound("WriteTextFile")
+}
+func (*client) CreateTerminal(context.Context, acp.CreateTerminalRequest) (acp.CreateTerminalResponse, error) {
+	return acp.CreateTerminalResponse{}, acp.NewMethodNotFound("CreateTerminal")
+}
+func (*client) KillTerminal(context.Context, acp.KillTerminalRequest) (acp.KillTerminalResponse, error) {
+	return acp.KillTerminalResponse{}, acp.NewMethodNotFound("KillTerminal")
+}
+func (*client) TerminalOutput(context.Context, acp.TerminalOutputRequest) (acp.TerminalOutputResponse, error) {
+	return acp.TerminalOutputResponse{}, acp.NewMethodNotFound("TerminalOutput")
+}
+func (*client) ReleaseTerminal(context.Context, acp.ReleaseTerminalRequest) (acp.ReleaseTerminalResponse, error) {
+	return acp.ReleaseTerminalResponse{}, acp.NewMethodNotFound("ReleaseTerminal")
+}
+func (*client) WaitForTerminalExit(context.Context, acp.WaitForTerminalExitRequest) (acp.WaitForTerminalExitResponse, error) {
+	return acp.WaitForTerminalExitResponse{}, acp.NewMethodNotFound("WaitForTerminalExit")
+}
+
+func (c *client) reply(ctx context.Context, a agent.Answer) error {
+	if c.hooks.Reply == nil || a.InteractionID == "" {
+		return c.fail(errors.New("reply audit callback missing"))
+	}
+	return c.fail(c.hooks.Reply(ctx, a.InteractionID))
+}
