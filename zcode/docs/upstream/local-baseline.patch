+            # cross-round leakage).
+            replies = self._read_state_replies()
+            self.assertEqual(len(replies), 2)
+            self.assertNotEqual(replies[0].get("id"), replies[1].get("id"))
+            self.assertEqual(replies[0]["result"]["action"], "cancel")
+            self.assertEqual(replies[1]["result"]["action"], "accept")
+            self.assertEqual(
