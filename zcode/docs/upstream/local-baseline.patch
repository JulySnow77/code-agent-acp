+                {"jsonrpc": "2.0", "id": f"uq_{i}",
+                 "result": {"outcome": {"outcome": "selected", "optionId": "x"}}}))
+        err = _stderr_of(bridge._drain_inbox)
+        perms = turn["perm_responses"]
+        self.assertLessEqual(len(perms), cap)  # 不超上限
+        self.assertIn("上限", err)             # 有 warning
