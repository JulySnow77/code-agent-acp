+package execution
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestActiveBudgetPausesForInteraction(t *testing.T) {
+	expired := make(chan struct{}, 1)
+	budget := newActiveBudget(60*time.Millisecond, func() { expired <- struct{}{} })
+	defer budget.Close()
+	budget.Pause()
+	select {
+	case <-expired:
+		t.Fatal("human wait consumed active budget")
+	case <-time.After(120 * time.Millisecond):
+	}
+	budget.Resume()
+	select {
+	case <-expired:
+	case <-time.After(time.Second):
+		t.Fatal("active budget did not resume")
+	}
+}
+func TestDiagnosticCredentialsAreRedacted(t *testing.T) {
+	for _, text := range []string{"Authorization: Bearer top-secret-value", "Authorization: Basic top-secret-value", "api_key=top-secret-value", `password="top-secret-value with spaces"`, `{"token":"top-secret-value"}`} {
+		if got := redact(text); strings.Contains(got, "top-secret-value") || strings.Contains(got, "with spaces") {
+			t.Fatalf("credential leaked: %s", got)
+		}
+	}
+}
diff --git a/internal/execution/process_test.go b/internal/execution/process_test.go
new file mode 100644
--- /dev/null
+++ b/internal/execution/process_test.go
@@ -0,0 +1,66 @@
+//go:build darwin || linux
+
+package execution
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestProcessGroupStopsDescendant(t *testing.T) {
+	dir := t.TempDir()
+	marker := filepath.Join(dir, "still-running")
+	stop := filepath.Join(dir, "stop")
+	defer os.WriteFile(stop, []byte("stop"), 0600)
+	// The shell leaves a background writer in the same process group.
+	p, err := startProcess("/bin/sh", []string{"-c", `(while [ ! -f "$2" ]; do echo tick >> "$1"; sleep 0.05; done) & wait`, "fixture", marker, stop}, dir, []string{"PATH=/usr/bin:/bin"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	t.Cleanup(func() {
+		os.WriteFile(stop, []byte("stop"), 0600)
+		select {
+		case <-p.done:
+		case <-time.After(2 * time.Second):
+			t.Error("cooperative fixture cleanup timed out")
+		}
+	})
+	defer p.Stop(context.Background(), 50*time.Millisecond)
+	deadline := time.Now().Add(time.Second)
+	for {
+		if _, err := os.Stat(marker); err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("writer never started")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if err = p.Stop(ctx, 50*time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(marker)
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(120 * time.Millisecond)
+	after, _ := os.ReadFile(marker)
+	if string(after) != string(before) {
+		t.Fatal("descendant kept writing after cleanup")
+	}
+}
+func TestChildEnvironmentDoesNotInheritOwnerCredential(t *testing.T) {
+	t.Setenv("ZORCH_OWNER_TOKEN", "test-private-owner")
+	t.Setenv("UNRELATED_CLOUD_KEY", "test-private-cloud")
+	env := childEnvironment(Profile{ProviderConfig: "/provider", BackendExecutable: "/backend"}, time.Second, time.Second)
+	for _, entry := range env {
+		if entry == "ZORCH_OWNER_TOKEN=test-private-owner" || entry == "UNRELATED_CLOUD_KEY=test-private-cloud" {
+			t.Fatal("owner credentials inherited")
+		}
+	}
+}
diff --git a/internal/execution/process_unix.go b/internal/execution/process_unix.go
new file mode 100644
--- /dev/null
+++ b/internal/execution/process_unix.go
@@ -0,0 +1,251 @@
+//go:build darwin || linux
+
+package execution
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"regexp"
+	"sync"
+	"syscall"
+	"time"
+)
+
+var ErrCleanupUncertain = errors.New("owned process group did not stop; workspace remains held")
+
+type tail struct {
+	mu    sync.Mutex
+	data  []byte
+	total int64
+}
+
+func (t *tail) Write(b []byte) (int, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.total += int64(len(b))
+	const max = 64 << 10
+	if len(b) >= max {
+		t.data = append(t.data[:0], b[len(b)-max:]...)
+	} else {
+		t.data = append(t.data, b...)
+		if len(t.data) > max {
+			t.data = append([]byte(nil), t.data[len(t.data)-max:]...)
+		}
+	}
+	return len(b), nil
+}
+
+var authorizationPattern = regexp.MustCompile(`(?i)(authorization["':= ]+)[^\r\n,}]+`)
+var bearerPattern = regexp.MustCompile(`(?i)(bearer\s+)[^\s,"'}]+`)
+var credentialPattern = regexp.MustCompile(`(?i)(api[_-]?key|token|password|secret)(\s*["']?\s*[:=]\s*|\s+)("[^"]*"|'[^']*'|[^\s,;}]+)`)
+
+func redact(s string) string {
+	s = authorizationPattern.ReplaceAllString(s, "${1}[REDACTED]")
+	s = bearerPattern.ReplaceAllString(s, "${1}[REDACTED]")
+	return credentialPattern.ReplaceAllString(s, "${1}${2}[REDACTED]")
+}
+
+func (t *tail) summary() (int64, bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.total, t.total > int64(len(t.data))
+}
+
+func (t *tail) text() string {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	data := t.data
+	if len(data) > 16<<10 {
+		data = data[len(data)-(16<<10):]
+	}
+	return redact(string(data))
+}
+
+type process struct {
+	cmd     *exec.Cmd
+	stdin   *os.File
+	stdout  *os.File
+	stderr  tail
+	done    chan struct{}
+	err     error
+	stopMu  sync.Mutex
+	stopped bool
+}
+
+func startProcess(binary string, args []string, cwd string, env []string) (*process, error) {
+	childIn, in, err := os.Pipe()
+	if err != nil {
+		return nil, err
+	}
+	out, childOut, err := os.Pipe()
+	if err != nil {
+		childIn.Close()
+		in.Close()
+		return nil, err
+	}
+	p := &process{stdin: in, stdout: out, done: make(chan struct{})}
+	p.cmd = exec.Command(binary, args...)
+	p.cmd.Dir = cwd
+	p.cmd.Env = env
+	p.cmd.Stdin = childIn
+	p.cmd.Stdout = childOut
+	p.cmd.Stderr = &p.stderr
+	p.cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	if err = p.cmd.Start(); err != nil {
+		childIn.Close()
+		childOut.Close()
+		in.Close()
+		out.Close()
+		return nil, err
+	}
+	childIn.Close()
+	childOut.Close()
+	go func() { p.err = p.cmd.Wait(); close(p.done) }()
+	return p, nil
+}
+func (p *process) PID() int { return p.cmd.Process.Pid }
+func (p *process) ExitCode() int {
+	select {
+	case <-p.done:
+		if p.cmd.ProcessState != nil {
+			return p.cmd.ProcessState.ExitCode()
+		}
+	default:
+	}
+	return -1
+}
+func (p *process) groupGone() (bool, error) {
+	err := syscall.Kill(-p.PID(), 0)
+	if errors.Is(err, syscall.ESRCH) {
+		return true, nil
+	}
+	return false, err
+}
+func (p *process) waitGone(ctx context.Context, wait time.Duration) bool {
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		gone, err := p.groupGone()
+		if err != nil {
+			return false
+		}
+		if gone {
+			select {
+			case <-p.done:
+				return true
+			case <-ctx.Done():
+				return false
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return false
+		case <-timer.C:
+			return false
+		case <-tick.C:
+		}
+	}
+}
+
+// Stop acts only on the group this live process handle created. It never adopts
+// stored PIDs across restarts. A caller must not release its workspace on error.
+func (p *process) Stop(ctx context.Context, grace time.Duration) error {
+	p.stopMu.Lock()
+	defer p.stopMu.Unlock()
+	if p.stopped {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, 2*grace+2*time.Second)
+	defer cancel()
+	p.stdin.Close()
+	if !p.waitGone(ctx, grace) {
+		if err := syscall.Kill(-p.PID(), syscall.SIGTERM); err != nil && !errors.Is(err, syscall.ESRCH) {
+			return fmt.Errorf("%w: %v", ErrCleanupUncertain, err)
+		}
+		if !p.waitGone(ctx, grace) {
+			if err := syscall.Kill(-p.PID(), syscall.SIGKILL); err != nil && !errors.Is(err, syscall.ESRCH) {
+				return fmt.Errorf("%w: %v", ErrCleanupUncertain, err)
+			}
+			if !p.waitGone(ctx, time.Second) {
+				return ErrCleanupUncertain
+			}
+		}
+	}
+	p.stdout.Close()
+	p.stopped = true
+	return nil
+}
+func childEnvironment(profile Profile, human, active time.Duration) []string {
+	env := []string{}
+	for _, key := range []string{"PATH", "HOME", "USER", "LOGNAME", "TMPDIR", "LANG", "LC_ALL"} {
+		if value, ok := os.LookupEnv(key); ok {
+			env = append(env, key+"="+value)
+		}
+	}
+	env = append(env, "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE="+profile.ProviderConfig, "ZCODE_ACP_QUESTION_TIMEOUT="+fmt.Sprint((human+time.Minute).Seconds()), "ZCODE_ACP_TURN_TIMEOUT="+fmt.Sprint(active.Seconds()))
+	if profile.BackendExecutable != "" {
+		env = append(env, "ZCODE_BIN="+profile.BackendExecutable)
+	}
+	return env
+}
+func runCheck(ctx context.Context, check Check, root string, env []string, grace time.Duration) (CheckResult, error) {
+	result := CheckResult{Executable: check.Executable, Args: check.Args}
+	directory := root
+	if check.Directory != "" && check.Directory != "." {
+		safe, err := os.OpenRoot(root)
+		if err != nil {
+			return result, err
+		}
+		sub, err := safe.OpenRoot(check.Directory)
+		safe.Close()
+		if err != nil {
+			return result, err
+		}
+		directory = sub.Name()
+		sub.Close()
+	}
+	checkCtx, cancel := context.WithTimeout(ctx, time.Duration(check.TimeoutSeconds)*time.Second)
+	defer cancel()
+	p, err := startProcess(check.Executable, check.Args, directory, env)
+	if err != nil {
+		return result, err
+	}
+	defer p.stdout.Close()
+	var output tail
+	drained := make(chan struct{})
+	go func() { io.Copy(&output, p.stdout); close(drained) }()
+	select {
+	case <-checkCtx.Done():
+		err = checkCtx.Err()
+	case <-p.done:
+	}
+	cleanup := p.Stop(context.WithoutCancel(ctx), grace)
+	if cleanup != nil {
+		return result, cleanup
+	}
+	<-drained
+	result.ExitCode = p.ExitCode()
+	result.OutputBytes, result.OutputTruncated = output.summary()
+	result.Output = output.text()
+	result.ErrorOutput = p.stderr.text()
+	result.ErrorBytes, result.ErrorTruncated = p.stderr.summary()
+	if result.ErrorBytes > 16<<10 {
+		result.ErrorTruncated = true
+	}
+	if result.OutputBytes > 16<<10 {
+		result.OutputTruncated = true
+	}
+	if err != nil {
+		return result, err
+	}
+	if result.ExitCode != check.ExpectedExitCode {
+		return result, fmt.Errorf("validation exit %d, expected %d", result.ExitCode, check.ExpectedExitCode)
+	}
+	return result, nil
+}
diff --git a/internal/execution/spec.go b/internal/execution/spec.go
new file mode 100644
--- /dev/null
+++ b/internal/execution/spec.go
@@ -0,0 +1,84 @@
+package execution
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+type Profile struct {
+	BridgeExecutable  string   `json:"bridgeExecutable"`
+	BridgeArgs        []string `json:"bridgeArgs,omitempty"`
+	BackendExecutable string   `json:"backendExecutable,omitempty"`
+	ProviderConfig    string   `json:"providerConfig"`
+	Model             string   `json:"model"`
+	Mode              string   `json:"mode"`
+}
+type Check struct {
+	Executable       string   `json:"executable"`
+	Args             []string `json:"args,omitempty"`
+	Directory        string   `json:"directory,omitempty"`
+	TimeoutSeconds   int      `json:"timeoutSeconds"`
+	ExpectedExitCode int      `json:"expectedExitCode"`
+}
+
+// Spec is persisted as the Run snapshot before execution; callers cannot replace
+// a live profile or prompt through a second set of Run() arguments.
+type Spec struct {
+	SchemaVersion int     `json:"schemaVersion"`
+	SnapshotID    string  `json:"snapshotId"`
+	Prompt        string  `json:"prompt"`
+	Profile       Profile `json:"profile"`
+	Checks        []Check `json:"checks,omitempty"`
+}
+
+func ParseSpec(raw []byte) (Spec, error) {
+	var s Spec
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&s); err != nil {
+		return s, err
+	}
+	if d.Decode(new(any)) != io.EOF {
+		return s, errors.New("expected one execution document")
+	}
+	if s.SchemaVersion != 1 || s.SnapshotID == "" || strings.TrimSpace(s.Prompt) == "" {
+		return s, errors.New("execution requires schemaVersion 1, snapshotId, and prompt")
+	}
+	if !filepath.IsAbs(s.Profile.BridgeExecutable) || !filepath.IsAbs(s.Profile.ProviderConfig) || s.Profile.Model == "" {
+		return s, errors.New("profile requires absolute executable/provider paths and explicit model")
+	}
+	if s.Profile.BackendExecutable != "" && !filepath.IsAbs(s.Profile.BackendExecutable) {
+		return s, errors.New("backend executable must be absolute")
+	}
+	switch s.Profile.Mode {
+	case "build", "plan", "edit", "yolo":
+	default:
+		return s, errors.New("profile requires an explicit known mode")
+	}
+	for _, c := range s.Checks {
+		if !filepath.IsAbs(c.Executable) || c.TimeoutSeconds < 1 || c.TimeoutSeconds > 3600 || c.ExpectedExitCode < 0 || c.ExpectedExitCode > 255 {
+			return s, errors.New("invalid validation command")
+		}
+		if c.Directory != "" && (filepath.IsAbs(c.Directory) || filepath.Clean(c.Directory) == ".." || strings.HasPrefix(filepath.Clean(c.Directory), ".."+string(filepath.Separator))) {
+			return s, errors.New("validation directory must stay inside workspace")
+		}
+	}
+	return s, nil
+}
+
+type Options struct{ Startup, Active, Human, Wall, Shutdown time.Duration }
+
+func DefaultOptions() Options {
+	return Options{Startup: time.Minute, Active: 30 * time.Minute, Human: 9 * time.Minute, Wall: 24 * time.Hour, Shutdown: 2 * time.Second}
+}
+func (o Options) validate() error {
+	if o.Startup <= 0 || o.Active <= 0 || o.Human <= 0 || o.Wall <= 0 || o.Shutdown <= 0 {
+		return errors.New("execution deadlines must be positive")
+	}
+	return nil
+}
diff --git a/internal/execution/supervisor.go b/internal/execution/supervisor.go
new file mode 100644
--- /dev/null
+++ b/internal/execution/supervisor.go
@@ -0,0 +1,415 @@
+package execution
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"zcode-orchestrator-go/internal/agent"
+	"zcode-orchestrator-go/internal/domain"
+	"zcode-orchestrator-go/internal/workspace"
+)
+
+var ErrActiveTimeout = errors.New("active execution budget exhausted")
+var ErrAgentCancelled = errors.New("agent cancelled the turn")
+var ErrHumanTimeout = errors.New("interaction deadline expired")
+
+type Repository interface {
+	GetRun(context.Context, string) (domain.Run, error)
+	StartAttempt(context.Context, string, int64, string, string) (domain.Run, domain.Attempt, error)
+	TransitionRun(context.Context, string, int64, domain.RunState) (domain.Run, error)
+	BeginExecution(context.Context, string, string, string) error
+	ExecutionStage(context.Context, domain.Execution) error
+	AppendAgentEvent(context.Context, string, string, []byte) error
+	FinishExecution(context.Context, string, domain.RunState, []byte) error
+	CreateInteraction(context.Context, domain.NewInteraction) (domain.Interaction, error)
+	RecordDecision(context.Context, string, int64, string, []byte) (domain.Interaction, error)
+	GetInteraction(context.Context, string) (domain.Interaction, error)
+	MarkReplyAttempted(context.Context, string, int64, string) (domain.Interaction, error)
+	ExpireInteractions(context.Context) (int, error)
+}
+type CheckResult struct {
+	ErrorBytes      int64    `json:"stderrBytes"`
+	ErrorTruncated  bool     `json:"stderrTruncated"`
+	Output          string   `json:"output,omitempty"`
+	ErrorOutput     string   `json:"stderr,omitempty"`
+	Executable      string   `json:"executable"`
+	Args            []string `json:"args,omitempty"`
+	ExitCode        int      `json:"exitCode"`
+	OutputBytes     int64    `json:"outputBytes"`
+	OutputTruncated bool     `json:"outputTruncated"`
+}
+type Result struct {
+	DispatchRecorded bool              `json:"promptDispatchRecorded"`
+	AttemptID        string            `json:"attemptId"`
+	State            domain.RunState   `json:"state"`
+	StopReason       string            `json:"stopReason"`
+	Text             string            `json:"text"`
+	TextTruncated    bool              `json:"textTruncated"`
+	Validation       string            `json:"validation"`
+	Checks           []CheckResult     `json:"checks,omitempty"`
+	Files            []workspace.Entry `json:"files,omitempty"`
+	ChangedPaths     []string          `json:"changedPaths,omitempty"`
+	ProcessStopped   bool              `json:"processStopped"`
+	Error            string            `json:"error,omitempty"`
+	StderrBytes      int64             `json:"stderrBytes"`
+	StderrTruncated  bool              `json:"stderrTruncated"`
+}
+type Supervisor struct {
+	Repo       Repository
+	Workspaces *workspace.Manager
+	NewAgent   agent.Factory
+	Options    Options
+	Answer     func(context.Context, domain.Interaction) (agent.Answer, error)
+}
+
+func newID() string {
+	var b [16]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		panic(err)
+	}
+	return hex.EncodeToString(b[:])
+}
+func (s *Supervisor) transition(ctx context.Context, run string, to domain.RunState) error {
+	r, err := s.Repo.GetRun(ctx, run)
+	if err != nil {
+		return err
+	}
+	_, err = s.Repo.TransitionRun(ctx, run, r.Version, to)
+	return err
+}
+func (s *Supervisor) Run(ctx context.Context, runID string) (result Result, runErr error) {
+	if s.Repo == nil || s.Workspaces == nil || s.NewAgent == nil {
+		return result, errors.New("supervisor dependencies missing")
+	}
+	if err := s.Options.validate(); err != nil {
+		return result, err
+	}
+	run, err := s.Repo.GetRun(ctx, runID)
+	if err != nil {
+		return result, err
+	}
+	if run.State != domain.Queued {
+		return result, domain.ErrConflict
+	}
+	spec, err := ParseSpec(run.Snapshot)
+	if err != nil {
+		return result, err
+	}
+	wall, wallCancel := context.WithTimeout(ctx, s.Options.Wall)
+	defer wallCancel()
+	life, cancel := context.WithCancelCause(wall)
+	defer cancel(nil)
+	_, attempt, err := s.Repo.StartAttempt(life, runID, run.Version, "attempt-"+newID(), "connection-"+newID())
+	if err != nil {
+		return result, err
+	}
+	result.AttemptID = attempt.ID
+	lease, err := s.Workspaces.Prepare(life, "workspace-"+attempt.ID, spec.SnapshotID, attempt.ID, attempt.ConnectionID)
+	if err != nil {
+		cleanupCtx, c := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+		defer c()
+		return result, errors.Join(err, s.transition(cleanupCtx, runID, domain.Failed))
+	}
+	defer lease.Close()
+	if err = s.Repo.BeginExecution(life, attempt.ID, lease.Workspace.ID, lease.Path); err != nil {
+		return result, err
+	}
+	var p *process
+	var client agent.Client
+	var dispatched bool
+	var budget *activeBudget
+	// All exits after the durable claim use the same outcome and teardown path.
+	defer func() {
+		if budget != nil {
+			budget.Close()
+		}
+		cleanupCtx, c := context.WithTimeout(context.WithoutCancel(ctx), 2*s.Options.Shutdown+8*time.Second)
+		defer c()
+		cause := context.Cause(life)
+		if client != nil {
+			if runErr != nil || cause != nil {
+				cancelCtx, cc := context.WithTimeout(cleanupCtx, s.Options.Shutdown)
+				_ = client.Cancel(cancelCtx)
+				cc()
+			}
+		}
+		var cleanupErr error
+		if p != nil {
+			cleanupErr = p.Stop(cleanupCtx, s.Options.Shutdown)
+			p.stdout.Close()
+			result.StderrBytes, result.StderrTruncated = p.stderr.summary()
+		}
+		if client != nil {
+			cleanupErr = errors.Join(cleanupErr, client.Close(cleanupCtx))
+		}
+		if errors.Is(runErr, ErrCleanupUncertain) {
+			cleanupErr = errors.Join(cleanupErr, ErrCleanupUncertain)
+		}
+		cause = context.Cause(life)
+		result.ProcessStopped = cleanupErr == nil
+		if cause != nil {
+			runErr = errors.Join(runErr, cause)
+		}
+		if cleanupErr != nil {
+			runErr = errors.Join(runErr, cleanupErr)
+			result.State = domain.Interrupted
+		} else if runErr != nil {
+			switch {
+			case errors.Is(cause, context.Canceled), errors.Is(runErr, ErrAgentCancelled):
+				result.State = domain.Cancelled
+			case errors.Is(cause, context.DeadlineExceeded), errors.Is(cause, ErrActiveTimeout), errors.Is(cause, ErrHumanTimeout):
+				result.State = domain.TimedOut
+			case dispatched && errors.Is(runErr, agent.ErrDisconnected):
+				result.State = domain.Interrupted
+			default:
+				result.State = domain.Failed
+			}
+		}
+		if result.ProcessStopped {
+			files, changed, e := s.Workspaces.CollectResult(cleanupCtx, lease.Workspace.ID, attempt.ID, attempt.ConnectionID)
+			if e != nil {
+				runErr = errors.Join(runErr, e)
+				result.State = domain.Failed
+			} else {
+				result.Files = files
+				result.ChangedPaths = changed
+			}
+		}
+		// An earlier interaction expiry may already have committed a terminal Run.
+		// Preserve that fact while recording uncertain cleanup and retaining its lease.
+		persistedRun, stateErr := s.Repo.GetRun(cleanupCtx, runID)
+		if stateErr != nil {
+			runErr = errors.Join(runErr, stateErr)
+		} else if persistedRun.State.Terminal() {
+			result.State = persistedRun.State
+		}
+		if runErr != nil {
+			result.Error = redact(runErr.Error())
+			if len(result.Error) > 4096 {
+				result.Error = result.Error[:4096]
+			}
+		}
+		raw, e := json.Marshal(result)
+		if e == nil {
+			e = s.Repo.FinishExecution(cleanupCtx, attempt.ID, result.State, raw)
+		}
+		if e != nil {
+			runErr = errors.Join(runErr, e)
+			return
+		}
+		if result.ProcessStopped {
+			runErr = errors.Join(runErr, lease.Release(cleanupCtx))
+		}
+	}()
+	stage := func(name string, session agent.Session) error {
+		return s.Repo.ExecutionStage(life, domain.Execution{AttemptID: attempt.ID, Stage: name, SessionID: session.ID, Model: session.Model, Mode: session.Mode, PID: func() int {
+			if p != nil {
+				return p.PID()
+			}
+			return 0
+		}()})
+	}
+	if err = stage("process_starting", agent.Session{}); err != nil {
+		return result, err
+	}
+	env := childEnvironment(spec.Profile, s.Options.Human, s.Options.Active)
+	args := append([]string{"serve"}, spec.Profile.BridgeArgs...)
+	args = append(args, "--mode", "build")
+	p, err = startProcess(spec.Profile.BridgeExecutable, args, lease.Path, env)
+	if err != nil {
+		return result, err
+	}
+	if err = stage("process_started", agent.Session{}); err != nil {
+		return result, err
+	}
+	budget = newActiveBudget(s.Options.Active, func() { cancel(ErrActiveTimeout) })
+	budget.Pause()
+	var interactionSeq atomic.Uint64
+	hooks := agent.Hooks{
+		Fail: cancel,
+		Event: func(c context.Context, e agent.Event) error {
+			return s.Repo.AppendAgentEvent(c, attempt.ID, e.Kind, e.Payload)
+		},
+		Interaction: func(c context.Context, request agent.Interaction) (agent.Answer, error) {
+			if budget != nil {
+				budget.Pause()
+				defer budget.Resume()
+			}
+			expires := time.Now().Add(s.Options.Human)
+			var metadata struct {
+				Meta struct {
+					Zcode struct {
+						Expires string `json:"expiresAt"`
+					} `json:"_zcode"`
+				} `json:"_meta"`
+			}
+			if json.Unmarshal(request.Request, &metadata) != nil {
+				return agent.Answer{}, errors.New("invalid interaction metadata")
+			}
+			if metadata.Meta.Zcode.Expires != "" {
+				outer, e := time.Parse(time.RFC3339Nano, metadata.Meta.Zcode.Expires)
+				if e != nil {
+					return agent.Answer{}, e
+				}
+				if outer.Before(expires) {
+					expires = outer
+				}
+			}
+			human, cc := context.WithDeadline(c, expires)
+			defer cc()
+			id := fmt.Sprintf("%s-%d", attempt.ConnectionID, interactionSeq.Add(1))
+			interaction, e := s.Repo.CreateInteraction(human, domain.NewInteraction{ID: id, AttemptID: attempt.ID, ConnectionID: attempt.ConnectionID, RequestKey: id, Kind: request.Kind, Request: request.Request, ExpiresAt: expires})
+			if e != nil {
+				return agent.Answer{}, e
+			}
+			var answer agent.Answer
+			if s.Answer == nil {
+				<-human.Done()
+				e = human.Err()
+			} else {
+				answer, e = s.Answer(human, interaction)
+			}
+			if human.Err() != nil {
+				e = human.Err()
+			}
+			if errors.Is(e, context.DeadlineExceeded) {
+				expiryCtx, ec := context.WithTimeout(context.WithoutCancel(c), time.Second)
+				_, expireErr := s.Repo.ExpireInteractions(expiryCtx)
+				ec()
+				return answer, errors.Join(ErrHumanTimeout, expireErr)
+			}
+			if e != nil {
+				return answer, e
+			}
+			raw, e := json.Marshal(answer)
+			if e != nil {
+				return answer, e
+			}
+			if _, e = s.Repo.RecordDecision(human, id, interaction.Version, attempt.ConnectionID, raw); e != nil {
+				return answer, e
+			}
+			answer.InteractionID = id
+			return answer, nil
+		},
+		Reply: func(c context.Context, id string) error {
+			i, e := s.Repo.GetInteraction(c, id)
+			if e != nil {
+				return e
+			}
+			_, e = s.Repo.MarkReplyAttempted(c, id, i.Version, attempt.ConnectionID)
+			return e
+		},
+	}
+	client = s.NewAgent(life, p.stdin, p.stdout, hooks)
+	startup, sc := context.WithTimeout(life, s.Options.Startup)
+	session, err := client.Prepare(startup, lease.Path, spec.Profile.Model, spec.Profile.Mode)
+	sc()
+	if err != nil {
+		return result, err
+	}
+	if err = stage("session_ready", session); err != nil {
+		return result, err
+	}
+	if err = s.transition(life, runID, domain.Running); err != nil {
+		return result, err
+	}
+	budget.Resume()
+	if err = stage("prompt_dispatching", session); err != nil {
+		return result, err
+	}
+	dispatched = true
+	result.DispatchRecorded = true
+	response, err := client.Prompt(life, spec.Prompt)
+	result.StopReason = response.StopReason
+	result.Text = response.Text
+	result.TextTruncated = response.TextTruncated
+	if err != nil {
+		return result, err
+	}
+	if response.StopReason == "cancelled" {
+		return result, ErrAgentCancelled
+	}
+	if response.StopReason != "end_turn" {
+		return result, fmt.Errorf("agent stopped with %s", response.StopReason)
+	}
+	if err = stage("prompt_finished", session); err != nil {
+		return result, err
+	}
+	if err = s.transition(life, runID, domain.Verifying); err != nil {
+		return result, err
+	}
+	if err = stage("verifying", session); err != nil {
+		return result, err
+	}
+	// Ensure the model cannot keep changing files while validation is running.
+	if err = p.Stop(life, s.Options.Shutdown); err != nil {
+		return result, err
+	}
+	if err = client.Close(life); err != nil {
+		return result, err
+	}
+	result.Validation = "not_configured"
+	for _, check := range spec.Checks {
+		checked, e := runCheck(life, check, lease.Path, env, s.Options.Shutdown)
+		result.Checks = append(result.Checks, checked)
+		if e != nil {
+			result.Validation = "failed"
+			return result, e
+		}
+		result.Validation = "passed"
+	}
+	result.State = domain.Succeeded
+	return result, nil
+}
+
+type activeBudget struct {
+	mu        sync.Mutex
+	remaining time.Duration
+	started   time.Time
+	waiters   int
+	timer     *time.Timer
+	closed    bool
+	expire    func()
+}
+
+func newActiveBudget(d time.Duration, expire func()) *activeBudget {
+	b := &activeBudget{remaining: d, started: time.Now(), expire: expire}
+	b.timer = time.AfterFunc(d, expire)
+	return b
+}
+func (b *activeBudget) Pause() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	if b.waiters == 0 {
+		b.timer.Stop()
+		b.remaining -= time.Since(b.started)
+	}
+	b.waiters++
+}
+func (b *activeBudget) Resume() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.waiters--
+	if b.waiters == 0 {
+		b.started = time.Now()
+		if b.remaining <= 0 {
+			b.expire()
+		} else {
+			b.timer.Reset(b.remaining)
+		}
+	}
+}
+func (b *activeBudget) Close() { b.mu.Lock(); defer b.mu.Unlock(); b.closed = true; b.timer.Stop() }
diff --git a/internal/store/sqlite/execution.go b/internal/store/sqlite/execution.go
new file mode 100644
--- /dev/null
+++ b/internal/store/sqlite/execution.go
@@ -0,0 +1,120 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"time"
+
+	"zcode-orchestrator-go/internal/domain"
+)
+
+func (s *Store) BeginExecution(ctx context.Context, attempt, workspace, cwd string) error {
+	return s.write(ctx, func(tx *sql.Tx) error {
+		var state domain.RunState
+		var held bool
+		var ready string
+		if err := tx.QueryRowContext(ctx, `SELECT a.state,w.held,w.state FROM attempts a JOIN workspaces w ON w.attempt_id=a.id WHERE a.id=? AND w.id=?`, attempt, workspace).Scan(&state, &held, &ready); err != nil {
+			return err
+		}
+		if state != domain.Preparing || !held || ready != "ready" {
+			return domain.ErrConflict
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO executions(attempt_id,workspace_id,stage,cwd) VALUES(?,?,'claimed',?)`, attempt, workspace, cwd); err != nil {
+			return err
+		}
+		return event(ctx, tx, "execution.claimed", attempt, map[string]any{"workspaceId": workspace}, time.Now().UTC())
+	})
+}
+
+var stages = map[string]string{"process_starting": "claimed", "process_started": "process_starting", "session_ready": "process_started", "prompt_dispatching": "session_ready", "prompt_finished": "prompt_dispatching", "verifying": "prompt_finished"}
+
+func (s *Store) ExecutionStage(ctx context.Context, e domain.Execution) error {
+	before, ok := stages[e.Stage]
+	if !ok {
+		return domain.ErrInvalid
+	}
+	return s.write(ctx, func(tx *sql.Tx) error {
+		var state domain.RunState
+		if err := tx.QueryRowContext(ctx, `SELECT state FROM attempts WHERE id=?`, e.AttemptID).Scan(&state); err != nil {
+			return err
+		}
+		if state.Terminal() || state == domain.Cancelling {
+			return domain.ErrConflict
+		}
+		result, err := tx.ExecContext(ctx, `UPDATE executions SET stage=?,pid=CASE WHEN ?>0 THEN ? ELSE pid END,session_id=CASE WHEN ?!='' THEN ? ELSE session_id END,model=CASE WHEN ?!='' THEN ? ELSE model END,mode=CASE WHEN ?!='' THEN ? ELSE mode END WHERE attempt_id=? AND stage=?`, e.Stage, e.PID, e.PID, e.SessionID, e.SessionID, e.Model, e.Model, e.Mode, e.Mode, e.AttemptID, before)
+		if err != nil {
+			return err
+		}
+		if err = oneRow(result); err != nil {
+			return err
+		}
+		return event(ctx, tx, "execution."+e.Stage, e.AttemptID, map[string]any{"pid": e.PID, "sessionId": e.SessionID, "model": e.Model, "mode": e.Mode}, time.Now().UTC())
+	})
+}
+func (s *Store) AppendAgentEvent(ctx context.Context, attempt, kind string, payload []byte) error {
+	if !strings.HasPrefix(kind, "agent.") || domain.CheckObject(payload) != nil {
+		return domain.ErrInvalid
+	}
+	return s.write(ctx, func(tx *sql.Tx) error {
+		var state domain.RunState
+		if err := tx.QueryRowContext(ctx, `SELECT state FROM attempts WHERE id=?`, attempt).Scan(&state); err != nil {
+			return err
+		}
+		if state.Terminal() {
+			return domain.ErrConflict
+		}
+		_, err := tx.ExecContext(ctx, `INSERT INTO events(kind,entity_id,schema_version,payload,created_at) VALUES(?,?,1,?,?)`, kind, attempt, string(payload), time.Now().UTC().UnixNano())
+		return err
+	})
+}
+func (s *Store) FinishExecution(ctx context.Context, attempt string, to domain.RunState, outcome []byte) error {
+	if !to.Terminal() || domain.CheckObject(outcome) != nil {
+		return domain.ErrInvalid
+	}
+	return s.write(ctx, func(tx *sql.Tx) error {
+		var runID, workspace string
+		if err := tx.QueryRowContext(ctx, `SELECT a.run_id,e.workspace_id FROM attempts a JOIN executions e ON e.attempt_id=a.id WHERE a.id=?`, attempt).Scan(&runID, &workspace); err != nil {
+			return err
+		}
+		r, err := scanRun(tx.QueryRowContext(ctx, "SELECT "+runColumns+" FROM runs WHERE id=?", runID))
+		if err != nil {
+			return err
+		}
+		if r.State.Terminal() && r.State != to {
+			return domain.ErrConflict
+		}
+		now := time.Now().UTC()
+		if to == domain.Cancelled && r.State != domain.Cancelling {
+			r, err = updateRun(ctx, tx, r, domain.Cancelling, now, true)
+			if err != nil {
+				return err
+			}
+		}
+		if !r.State.Terminal() {
+			if _, err = updateRun(ctx, tx, r, to, now, true); err != nil {
+				return err
+			}
+		}
+		res, err := tx.ExecContext(ctx, `UPDATE executions SET stage='finished',outcome=? WHERE attempt_id=? AND stage!='finished'`, string(outcome), attempt)
+		if err != nil {
+			return err
+		}
+		if err = oneRow(res); err != nil {
+			return err
+		}
+		if _, err = tx.ExecContext(ctx, `INSERT OR IGNORE INTO workspace_references(workspace_id,reference_id) VALUES(?,?)`, workspace, "execution:"+attempt); err != nil {
+			return err
+		}
+		return event(ctx, tx, "execution.finished", attempt, map[string]any{"state": to, "resultReference": "execution:" + attempt}, now)
+	})
+}
+func (s *Store) GetExecution(ctx context.Context, attempt string) (domain.Execution, error) {
+	var e domain.Execution
+	var outcome sql.NullString
+	err := s.db.QueryRowContext(ctx, `SELECT attempt_id,workspace_id,stage,pid,session_id,cwd,model,mode,outcome FROM executions WHERE attempt_id=?`, attempt).Scan(&e.AttemptID, &e.WorkspaceID, &e.Stage, &e.PID, &e.SessionID, &e.Cwd, &e.Model, &e.Mode, &outcome)
+	if outcome.Valid {
+		e.Outcome = []byte(outcome.String)
+	}
+	return e, classify(err)
+}
