+
+// CollectResult reads the stopped owner's tree without releasing its lease. The
+// caller must keep ownership until its outcome and reference are persisted.
+func (m *Manager) CollectResult(ctx context.Context, id, attempt, epoch string) ([]Entry, []string, error) {
+	w, err := m.repo.GetWorkspace(ctx, id)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !w.Held || w.State != "ready" || w.AttemptID != attempt || w.ConnectionID != epoch {
+		return nil, nil, domain.ErrConflict
+	}
+	if _, err = m.checkOwner(w); err != nil {
+		return nil, nil, err
+	}
+	tree, err := m.openManaged(workspaceDir(id) + "/tree")
+	if err != nil {
+		return nil, nil, err
+	}
+	defer tree.Close()
+	p := m.policy
+	p.Exclude = nil
+	files, _, err := scan(ctx, tree.Name(), nil, p, nil)
+	if err != nil {
+		return nil, nil, err
+	}
+	baseline, err := m.SnapshotManifest(ctx, w.SnapshotID)
+	if err != nil {
+		return nil, nil, err
+	}
+	old := map[string]Entry{}
+	for _, e := range baseline.Files {
+		old[e.Path] = e
+	}
+	changed := []string{}
+	for _, e := range files {
+		if prior, ok := old[e.Path]; !ok || prior != e {
+			changed = append(changed, e.Path)
+		}
+		delete(old, e.Path)
+	}
+	for path := range old {
+		changed = append(changed, path)
+	}
+	sort.Strings(changed)
+	return files, changed, nil
+}
diff --git a/test/contract/execution_test.go b/test/contract/execution_test.go
new file mode 100644
--- /dev/null
+++ b/test/contract/execution_test.go
@@ -0,0 +1,218 @@
+//go:build contract
+
+package contract
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"zcode-orchestrator-go/internal/agent"
+	"zcode-orchestrator-go/internal/app"
+	"zcode-orchestrator-go/internal/config"
+	"zcode-orchestrator-go/internal/domain"
+	"zcode-orchestrator-go/internal/execution"
+	"zcode-orchestrator-go/internal/workspace"
+)
+
+var bridge, fake string
+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "zorch-execution-contract-")
+	if err != nil {
+		panic(err)
+	}
+	bridgeSource := os.Getenv("ZORCH_TEST_BRIDGE_DIR")
+	if bridgeSource == "" {
+		bridgeSource = "../../../zcode-open-bridge-go"
+	}
+	bridgeSource, err = filepath.Abs(bridgeSource)
+	if err != nil {
+		panic(err)
+	}
+	bridge = filepath.Join(dir, "bridge")
+	fake = filepath.Join(dir, "fake-zcode")
+	for _, build := range []struct{ cwd, out, target string }{{bridgeSource, bridge, "./cmd/zcode-acp-bridge"}, {"../..", fake, "./test/fixture/zcode"}} {
+		cmd := exec.Command("go", "build", "-buildvcs=false", "-o", build.out, build.target)
+		cmd.Dir = build.cwd
+		if raw, err := cmd.CombinedOutput(); err != nil {
+			fmt.Fprintf(os.Stderr, "build contract fixture: %v\n%s", err, raw)
+			os.RemoveAll(dir)
+			os.Exit(1)
+		}
+	}
+	code := m.Run()
+	os.RemoveAll(dir)
+	os.Exit(code)
+}
+func quote(s string) string { return "'" + strings.ReplaceAll(s, "'", "'\\''") + "'" }
+func setup(t *testing.T, scenario string, checks []execution.Check) (*app.Runtime, string, string) {
+	t.Helper()
+	ctx := context.Background()
+	base := t.TempDir()
+	cfg, err := config.Defaults()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.DataDir = filepath.Join(base, "data")
+	runtime, err := app.Open(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { runtime.Close() })
+	source := filepath.Join(base, "source")
+	if err = os.Mkdir(source, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(source, "initial.txt"), []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = runtime.Workspaces.RegisterProject(ctx, "project", source); err != nil {
+		t.Fatal(err)
+	}
+	snap, err := runtime.Workspaces.Capture(ctx, workspace.CaptureRequest{ID: "snapshot", ProjectID: "project"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	log := filepath.Join(base, "requests.jsonl")
+	wrapper := filepath.Join(base, "backend")
+	provider := filepath.Join(base, "provider.json")
+	script := "#!/bin/sh\nexport O04_SCENARIO=" + quote(scenario) + "\nexport O04_LOG=" + quote(log) + "\nexec " + quote(fake) + " \"$@\"\n"
+	if err = os.WriteFile(wrapper, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(provider, []byte(`{"providers":{}}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	spec := execution.Spec{SchemaVersion: 1, SnapshotID: snap.ID, Prompt: "write result.txt", Profile: execution.Profile{BridgeExecutable: bridge, BackendExecutable: wrapper, ProviderConfig: provider, Model: "p/model", Mode: "build"}, Checks: checks}
+	raw, _ := json.Marshal(spec)
+	if _, err = runtime.Store.CreateRun(ctx, domain.NewRun{ID: "run", TaskVersionID: "version", Snapshot: raw}); err != nil {
+		t.Fatal(err)
+	}
+	runtime.Executor.Options = execution.Options{Startup: 5 * time.Second, Active: 5 * time.Second, Human: time.Second, Wall: 15 * time.Second, Shutdown: execution.DefaultOptions().Shutdown}
+	return runtime, log, source
+}
+func TestCompletionAndValidation(t *testing.T) {
+	runtime, _, source := setup(t, "ok", []execution.Check{{Executable: "/bin/sh", Args: []string{"-c", "test \"$(cat result.txt)\" = done"}, TimeoutSeconds: 2}})
+	result, err := runtime.Executor.Run(context.Background(), "run")
+	if err != nil {
+		t.Fatalf("run: %v; result=%+v", err, result)
+	}
+	if result.State != domain.Succeeded || result.Validation != "passed" || !result.ProcessStopped || result.Text != "Task complete" {
+		t.Fatalf("incomplete outcome: %+v", result)
+	}
+	if _, err = os.Stat(filepath.Join(source, "result.txt")); !os.IsNotExist(err) {
+		t.Fatal("original project was modified")
+	}
+	record, err := runtime.Store.GetExecution(context.Background(), result.AttemptID)
+	if err != nil || record.Stage != "finished" || record.SessionID != "fixture-session" {
+		t.Fatalf("execution record: %+v %v", record, err)
+	}
+	var persisted execution.Result
+	if err = json.Unmarshal(record.Outcome, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if len(persisted.ChangedPaths) != 1 || persisted.ChangedPaths[0] != "result.txt" {
+		t.Fatalf("missing file result: %+v", persisted)
+	}
+	events, err := runtime.Store.Events(context.Background(), 0, 100)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var dispatch, message int64
+	for _, e := range events {
+		if e.Kind == "execution.prompt_dispatching" {
+			dispatch = e.Sequence
+		}
+		if e.Kind == "agent.message" {
+			message = e.Sequence
+		}
+	}
+	if dispatch == 0 || message <= dispatch {
+		t.Fatalf("dispatch was not durably recorded before output: %d %d", dispatch, message)
+	}
+}
+func TestModelFailureDoesNotPrompt(t *testing.T) {
+	for _, scenario := range []string{"model_error", "model_mismatch"} {
+		t.Run(scenario, func(t *testing.T) {
+			runtime, log, _ := setup(t, scenario, nil)
+			_, err := runtime.Executor.Run(context.Background(), "run")
+			if err == nil {
+				t.Fatal("model failure became success")
+			}
+			raw, err := os.ReadFile(log)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(string(raw), `"method":"session/send"`) {
+				t.Fatal("prompt sent before model confirmation")
+			}
+		})
+	}
+}
+func TestExplicitPermissionAndForm(t *testing.T) {
+	for _, scenario := range []string{"permission", "form"} {
+		t.Run(scenario, func(t *testing.T) {
+			runtime, _, _ := setup(t, scenario, nil)
+			runtime.Executor.Answer = func(ctx context.Context, i domain.Interaction) (agent.Answer, error) {
+				if i.Kind == "permission" {
+					return agent.Answer{Action: "accept", OptionID: "allow_once"}, nil
+				}
+				return agent.Answer{Action: "accept", Content: map[string]any{"Approve plan?": "approve"}}, nil
+			}
+			result, err := runtime.Executor.Run(context.Background(), "run")
+			if err != nil {
+				t.Fatalf("explicit answer: %v (%+v)", err, result)
+			}
+			if result.State != domain.Succeeded || result.Validation != "not_configured" {
+				t.Fatalf("unexpected outcome %+v", result)
+			}
+		})
+	}
+}
+func TestDefaultInteractionWaitsAndExpires(t *testing.T) {
+	runtime, _, _ := setup(t, "permission", nil)
+	runtime.Executor.Options.Human = 100 * time.Millisecond
+	result, err := runtime.Executor.Run(context.Background(), "run")
+	if err == nil {
+		t.Fatal("unanswered permission succeeded")
+	}
+	if result.State != domain.TimedOut || !result.ProcessStopped {
+		t.Fatalf("expired request did not stop: %+v %v", result, err)
+	}
+}
+func TestCancelActiveRun(t *testing.T) {
+	runtime, log, _ := setup(t, "wait", nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() {
+		deadline := time.Now().Add(5 * time.Second)
+		for time.Now().Before(deadline) {
+			raw, _ := os.ReadFile(log)
+			if strings.Contains(string(raw), `"method":"session/send"`) {
+				cancel()
+				return
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		cancel()
+	}()
+	result, err := runtime.Executor.Run(ctx, "run")
+	if err == nil || result.State != domain.Cancelled || !result.ProcessStopped {
+		t.Fatalf("cancel: %+v %v", result, err)
+	}
+}
+
+func TestFailedValidationIsNotSuccess(t *testing.T) {
+	runtime, _, _ := setup(t, "no_file", []execution.Check{{Executable: "/bin/sh", Args: []string{"-c", "test -f result.txt"}, TimeoutSeconds: 2}})
+	result, err := runtime.Executor.Run(context.Background(), "run")
+	if err == nil || result.State != domain.Failed || result.Validation != "failed" || !result.ProcessStopped {
+		t.Fatalf("false validation success: %+v %v", result, err)
+	}
+}
