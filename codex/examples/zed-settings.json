{
  "agent_servers": {
    "Codex (Go ACP adapter)": {
      "type": "custom",
      "command": "/ABS/PATH/TO/code-agent-acp/codex/bin/codex-acp-bridge",
      "args": ["serve"],
      "env": {
        "CODEX_BIN": "codex",
        "CODEX_ACP_APPROVAL_POLICY": "on-request",
        "CODEX_ACP_SANDBOX": "workspace-write"
      }
    }
  }
}
