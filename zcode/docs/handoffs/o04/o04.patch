+}
+func TestDispatchAndResultAreDurable(t *testing.T) {
+	s, r, a := executionFixture(t)
+	ctx := context.Background()
+	if err := s.ExecutionStage(ctx, domain.Execution{AttemptID: a.ID, Stage: "prompt_dispatching"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.AppendAgentEvent(ctx, a.ID, "agent.message", []byte(`{"text":"done"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ExecutionStage(ctx, domain.Execution{AttemptID: a.ID, Stage: "prompt_finished"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.TransitionRun(ctx, r.ID, r.Version, domain.Verifying); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ExecutionStage(ctx, domain.Execution{AttemptID: a.ID, Stage: "verifying"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.FinishExecution(ctx, a.ID, domain.Succeeded, []byte(`{"validation":"not_configured"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ReleaseWorkspace(ctx, "workspace", a.ID, a.ConnectionID); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.CheckWorkspaceCleanup(ctx, "workspace"); !errors.Is(err, domain.ErrConflict) {
+		t.Fatalf("result workspace was not pinned: %v", err)
+	}
+	e, err := s.GetExecution(ctx, a.ID)
+	if err != nil || e.Stage != "finished" || len(e.Outcome) == 0 {
+		t.Fatalf("result: %+v %v", e, err)
+	}
+	if err = s.AppendAgentEvent(ctx, a.ID, "agent.message", []byte(`{}`)); !errors.Is(err, domain.ErrConflict) {
+		t.Fatalf("late event changed terminal attempt: %v", err)
+	}
+	if err = s.FinishExecution(ctx, a.ID, domain.Failed, []byte(`{}`)); !errors.Is(err, domain.ErrConflict) {
+		t.Fatalf("terminal result overwritten: %v", err)
+	}
+}
+func TestDispatchRecordFailureDoesNotAdvance(t *testing.T) {
+	s, _, a := executionFixture(t)
+	ctx := context.Background()
+	before, _ := s.Events(ctx, 0, 100)
+	if _, err := s.db.Exec(`CREATE TRIGGER refuse_dispatch BEFORE INSERT ON events WHEN NEW.kind='execution.prompt_dispatching' BEGIN SELECT RAISE(ABORT,'injected'); END`); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ExecutionStage(ctx, domain.Execution{AttemptID: a.ID, Stage: "prompt_dispatching"}); err == nil {
+		t.Fatal("dispatch persistence error ignored")
+	}
+	e, err := s.GetExecution(ctx, a.ID)
+	if err != nil || e.Stage != "session_ready" {
+		t.Fatalf("partial dispatch state: %+v %v", e, err)
+	}
+	after, _ := s.Events(ctx, 0, 100)
+	if len(after) != len(before) {
+		t.Fatal("dispatch event escaped rollback")
+	}
+}
