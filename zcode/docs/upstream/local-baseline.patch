+
+    def test_reply_after_turn_ended_is_dropped_with_log(self):
+        # turn 已不在 pending_turns 时, _drain_inbox 收到 reply 要 warning 且不崩
+        bridge = MOD.ACPBridge()
+        bridge.backend = RespondRecorder()
+        # 不注册任何 turn → pending_turns 为空
+        bridge._inbox.put(json.dumps(
+            {"jsonrpc": "2.0", "id": "uq_99",
+             "result": {"outcome": {"outcome": "selected", "optionId": "Vue"}}}))
+        err = _stderr_of(bridge._drain_inbox)
+        self.assertIn("无在飞 turn", err)
+        self.assertEqual(bridge.backend.replies, [])  # 不该有副作用
+
+    def test_perm_responses_cap_evicts_oldest(self):
+        # _PERM_RESPONSES_CAP 之外的 reply 不应无限制堆积; 超限丢最早且打 warning
+        bridge = MOD.ACPBridge()
+        bridge.backend = RespondRecorder()
+        turn = {"zcode_sid": "z1", "cancelled": False}
+        bridge.pending_turns["p1"] = turn
+        cap = MOD._PERM_RESPONSES_CAP
+        for i in range(cap + 3):
