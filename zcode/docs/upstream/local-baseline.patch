+    def test_non_selected_outcome_logs_and_cancels(self):
+        # outcome=cancelled (非 selected) 以前静默 cancel, 现在要打 "非 selected" 日志
+        bridge, turn = _bridge_with_turn()
+        bridge._inbox.put(json.dumps(
