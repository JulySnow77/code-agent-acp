+class TestAskUserQuestionReaskE2E(unittest.TestCase):
+    """The production regression shape: the question displays AGAIN in the
+    same turn.
+
+    After the first ``interaction/requestUserInput`` is answered (or
+    cancelled because the web reply was lost), the model may re-ask
+    before the turn ends. zcode then emits a SECOND server-initiated
+    request with a fresh rpcId. The bridge must surface it as a NEW
+    ``session/request_permission`` (fresh id — the web keys cards by
+    id), deliver the second round's answer to the second rpcId, and
+    never let a stale reply for round 1 satisfy or corrupt round 2.
+    """
+
+    def setUp(self) -> None:
+        self._state_file = tempfile.NamedTemporaryFile(
+            mode="w", suffix=".json", delete=False
+        )
+        self._state_file.close()
+
+    def tearDown(self) -> None:
+        try:
+            os.unlink(self._state_file.name)
+        except OSError:
+            pass
+
+    def _read_state_replies(self) -> list[dict[str, Any]]:
+        with open(self._state_file.name, encoding="utf-8") as f:
+            payload = json.load(f)
+        if isinstance(payload, dict) and "replies" in payload:
+            return payload["replies"]
+        return [payload]
+
+    def test_second_request_in_same_turn_surfaces_and_delivers(self) -> None:
+        proc = _spawn_bridge({"FAKE_ZCODE_STATE_FILE": self._state_file.name})
+        client = ACPClient(proc)
+        try:
+            acp_sid = _init_and_new_session(client)
+
+            def answer(msg: dict[str, Any], perms: list[dict[str, Any]]) -> None:
+                if len(perms) == 1:
+                    # Round 1: user dismisses the card (or the web reply
+                    # was lost and the bridge is replaying the cancel).
+                    client.send({
+                        "jsonrpc": "2.0",
+                        "id": msg["id"],
+                        "result": {"outcome": {"outcome": "cancelled"}},
+                    })
+                else:
+                    # Round 2 (re-ask): the user answers for real.
+                    client.send({
+                        "jsonrpc": "2.0",
+                        "id": msg["id"],
+                        "result": {"outcome": {"outcome": "selected",
+                                               "optionId": "Dark"}},
+                    })
+
+            perms, prompt_resp = _drive_prompt(
+                client, acp_sid, "ASK_USER_QUESTION_TWICE", answer
+            )
+
+            # The re-ask MUST surface as a second card with a fresh id —
+            # reusing the round-1 id would make the web render into the
+            # stale (already-resolved) card and the re-submit would 404.
+            self.assertEqual(len(perms), 2,
+                             "re-ask in the same turn must surface as a second "
+                             "session/request_permission")
+            self.assertNotEqual(perms[0]["id"], perms[1]["id"])
+            q1 = perms[0]["params"]["toolCall"]["rawInput"]["questions"]
+            q2 = perms[1]["params"]["toolCall"]["rawInput"]["questions"]
+            self.assertEqual(q1[0]["question"], "Which framework should we use?")
+            self.assertEqual(q2[0]["question"], "Pick a color theme?")
