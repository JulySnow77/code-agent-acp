+class TestAskUserQuestionMultiQuestionE2E(unittest.TestCase):
+    """One requestUserInput carrying N questions → N sequential permission
+    requests → ONE accept carrying every answer keyed by question text.
+
+    Real zcode batches several questions in a single
+    ``interaction/requestUserInput`` (verified against the real CLI: the
+    model asked 2 questions in one tool call, the bridge fanned them out
+    as uq_1/uq_2). The web client renders+answers each card; zcode must
+    receive ALL answers in a single accept reply. A bridge that drops
+    later answers leaves the model without the full result — the web
+    then shows the question list again and a re-submit hits an
+    already-answered request (the production symptom).
+    """
+
+    def setUp(self) -> None:
+        self._state_file = tempfile.NamedTemporaryFile(
+            mode="w", suffix=".json", delete=False
+        )
+        self._state_file.close()
+
+    def tearDown(self) -> None:
+        try:
+            os.unlink(self._state_file.name)
+        except OSError:
+            pass
+
+    def test_multi_question_batch_delivers_all_answers(self) -> None:
+        proc = _spawn_bridge({"FAKE_ZCODE_STATE_FILE": self._state_file.name})
+        client = ACPClient(proc)
+        try:
+            acp_sid = _init_and_new_session(client)
+
+            def answer(msg: dict[str, Any], perms: list[dict[str, Any]]) -> None:
+                if len(perms) == 1:
+                    # Question 1 (framework): single-select label.
+                    option_id: Any = "Vue"
+                else:
+                    # Question 2 (platforms, multiSelect): omnigent encodes
+                    # a list answer as a JSON-array string optionId — pin
+                    # that encoding end-to-end here.
+                    option_id = json.dumps(["iOS", "Web"], ensure_ascii=False)
+                client.send({
+                    "jsonrpc": "2.0",
+                    "id": msg["id"],
+                    "result": {"outcome": {"outcome": "selected", "optionId": option_id}},
+                })
+
+            perms, prompt_resp = _drive_prompt(
+                client, acp_sid, "Please ASK_USER_QUESTION_MULTI now.", answer
+            )
+
+            # One session/request_permission per question, with distinct
+            # request ids (the web keys each card by id).
+            self.assertEqual(len(perms), 2,
+                             "expected one permission request per batched question")
+            self.assertNotEqual(perms[0]["id"], perms[1]["id"])
+
+            # Each card carries exactly ONE question in rawInput (the
+            # bridge fans the batch out) so omnigent renders a form for
+            # that single question.
+            q1 = perms[0]["params"]["toolCall"]["rawInput"]["questions"]
+            q2 = perms[1]["params"]["toolCall"]["rawInput"]["questions"]
+            self.assertEqual([q.get("question") for q in q1],
+                             ["Which framework should we use?"])
+            self.assertEqual([q.get("question") for q in q2],
+                             ["Which platforms must be supported?"])
+            self.assertTrue(q2[0].get("multiSelect"))
+            self.assertEqual(perms[0]["params"]["toolCall"]["title"], "AskUserQuestion")
+            self.assertEqual(perms[1]["params"]["toolCall"]["title"], "AskUserQuestion")
+
+            self.assertIsNotNone(
+                prompt_resp,
+                "prompt never completed — a batched answer likely not delivered",
+            )
+            self.assertEqual(prompt_resp["result"]["stopReason"], "end_turn")
+
+            # The literal accept payload zcode received: ONE reply with
+            # BOTH answers, keyed by question text (the key zcode's
+            # normalizeAskUserQuestion reads), the multiSelect answer as
+            # a real list.
+            with open(self._state_file.name, encoding="utf-8") as f:
+                zcode_reply = json.load(f)
+            self.assertEqual(zcode_reply["result"]["action"], "accept")
+            self.assertEqual(
+                zcode_reply["result"]["content"]["answers"],
+                {
+                    "Which framework should we use?": "Vue",
+                    "Which platforms must be supported?": ["iOS", "Web"],
